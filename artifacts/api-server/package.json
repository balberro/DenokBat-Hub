{
  "name": "@workspace/api-server",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch ./src/index.ts",
    "build": "tsx ./build.ts",
    "start": "NODE_ENV=production node ./dist/index.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "import:genero": "tsx ./src/scripts/import-genero-corrections.ts"
  },
  "dependencies": {
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2",
    "drizzle-orm": "catalog:",
    "express": "^5",
    "jsonwebtoken": "^9.0.3",
    "xmlrpc": "^1.3.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "catalog:",
    "@types/xmlrpc": "^1.3.10",
    "esbuild": "^0.27.3",
    "tsx": "catalog:"
  }
}
