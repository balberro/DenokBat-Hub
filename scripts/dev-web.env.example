# Copia este archivo como scripts/dev-web.env.local y rellena los valores.
# El script scripts/start-web-dev.sh lo cargará automáticamente.
#
# IMPORTANTE: este fichero (.example) NO debe contener secretos reales.
# Todos los valores que llevan "REPLACE_ME" están pensados para sobrescribirse
# en tu .env.local, que está ignorado por git (.gitignore).

DATABASE_URL=postgres://denokbat:denokbat@127.0.0.1:5432/denokbat
JWT_SECRET=REPLACE_ME_CON_SECRETO_LARGO

API_PORT=8080
WEB_PORT=8081
BASE_PATH=/
API_PROXY_TARGET=http://127.0.0.1:8080
FORCE_RESTART=0

ODOO_URL=http://localhost:8069
ODOO_DB=Denokbat-dev
ODOO_USERNAME=odoo
ODOO_PASSWORD=REPLACE_ME
ODOO_API_KEY=REPLACE_ME

# --- SMTP para envío de emails (actas firmadas, avisos de sugerencias, ...) ---
# Si SMTP_HOST, SMTP_PORT y SMTP_FROM están definidos, el envío es real;
# si falta cualquiera, el envío se simula y queda registrado en el log.
# Ejemplo Gmail (con contraseña de aplicación):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=0           # 1/true -> conexión TLS directa (puerto 465); 0/false -> STARTTLS (587)
#   SMTP_USER=usuario@dominio.com
#   SMTP_PASS=app-password-de-16-caracteres
#   SMTP_FROM="Denok Bat <no-reply@denokbat.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Buzón al que se notifican nuevas sugerencias/aportaciones.
SUGERENCIAS_NOTIFY_EMAIL=

# Si =1 (default), el From: del aviso de sugerencias lleva la dirección del
# usuario que la envía. Si tu SMTP rechaza remitentes ajenos al dominio
# autenticado (típico con SPF/DKIM), pon SUGERENCIAS_FROM_USER=0: el From
# será SMTP_FROM y la dirección del usuario irá en Reply-To.
SUGERENCIAS_FROM_USER=1
