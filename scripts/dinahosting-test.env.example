# Copia este archivo como scripts/dinahosting-test.env.local
# y ajusta valores para el entorno de test en Dinahosting.

NODE_ENV=production
PORT=8080

# URL pública del frontend en test (necesaria para CORS en producción).
ALLOWED_ORIGINS=https://test.denokbat.eus

# PostgreSQL en Dinahosting o externo.
DATABASE_URL=postgres://usuario:password@host:5432/denokbat_test

# Cambia esta clave por un valor largo y aleatorio.
JWT_SECRET=REEMPLAZAR_CON_SECRETO_LARGO

# Odoo opcional
ODOO_URL=https://vls18755.dinaserver.com
ODOO_DB=dinaserver
ODOO_USERNAME=dinaodooapi
ODOO_PASSWORD=
ODOO_API_KEY=

# SMTP para notificaciones (sugerencias, actas, etc.).
# Si no se configura, los envíos caen al modo log y no se entregan.
SMTP_HOST=smtp.dinaserver.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Denok-Bat <no-reply@denokbat.eus>"

# Destinatario interno de las notificaciones de sugerencias.
SUGERENCIAS_NOTIFY_EMAIL=sugerencias@denokbat.eus

# Si vale 1, el From del correo de sugerencias es el email del propio
# usuario que la envía (útil para responderle directo). Si tu SMTP rechaza
# remitentes arbitrarios (lo habitual con SPF/DKIM estrictos), ponlo a 0
# para usar SMTP_FROM con el email del usuario en Reply-To.
SUGERENCIAS_FROM_USER=1

# Si cambias la ruta de build del frontend, ajusta aquí.
# Por defecto la API buscará artifacts/denok-bat/dist/public.
# WEB_DIST_DIR=artifacts/denok-bat/dist/public
