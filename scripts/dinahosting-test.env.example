# Copia este archivo como scripts/dinahosting-test.env.local
# y ajusta valores para el entorno de test en Dinahosting.

NODE_ENV=production
PORT=8080

# URL pública del frontend en test (necesaria para CORS en producción).
ALLOWED_ORIGINS=https://test.denokbat.eus

# PostgreSQL en Dinahosting o externo.
DATABASE_URL=postgres://usuario:password@host:5432/denokbat_test

# Cambia esta clave por un valor largo y aleatorio.
JWT_SECRET=REEMPLAZAR_CON_SECRETO_LARGO

# Odoo opcional
ODOO_URL=https://vls18755.dinaserver.com
ODOO_DB=dinaserver
ODOO_USERNAME=dinaodooapi
ODOO_PASSWORD=
ODOO_API_KEY=

# Si cambias la ruta de build del frontend, ajusta aquí.
# Por defecto la API buscará artifacts/denok-bat/dist/public.
# WEB_DIST_DIR=artifacts/denok-bat/dist/public
